//Q21. Palindrome number
class Palindrome {
    static int countChecks = 0;

    void check(int number) {
        countChecks++;

        int original = number;
        int temp = number;
        int reverse = 0;

        if (number < 0) {
            System.out.println("Not a Palindrome");
            return;
        }

        while (temp > 0) {
            int digit = temp % 10;
            reverse = reverse * 10 + digit;
            temp = temp / 10;
        }

        if (original == reverse)
            System.out.println(original + " is Palindrome");
        else
            System.out.println(original + " is Not Palindrome");
    }

    public static void main(String[] args) {
        Palindrome p = new Palindrome();

        p.check(121);
        p.check(123);

        System.out.println("Total Checks: " + countChecks);
    }
}
//Q22. Armstrong number
class Armstrong {
    static int totalChecks = 0;

    void check(int number) {
        totalChecks++;

        int original = number;
        int temp = number;
        int digits = 0;
        int sum = 0;

        if (number < 0) {
            System.out.println("Not an Armstrong Number");
            return;
        }

        if (temp == 0)
            digits = 1;

        while (temp > 0) {
            digits++;
            temp = temp / 10;
        }

        temp = number;

        while (temp > 0) {
            int digit = temp % 10;
            sum += (int) Math.pow(digit, digits);
            temp = temp / 10;
        }

        if (original == sum)
            System.out.println(original + " is Armstrong");
        else
            System.out.println(original + " is Not Armstrong");
    }

    public static void main(String[] args) {
        Armstrong a = new Armstrong();

        a.check(153);
        a.check(123);

        System.out.println("Total Checks: " + totalChecks);
    }
}
//Q23. PrimeChecker
class PrimeChecker {
    static int totalPrimeChecks = 0;

    void check(int number) {
        totalPrimeChecks++;

        boolean isPrime = number >= 2;

        for (int i = 2; i <= number / i && isPrime; i++) {
            if (number % i == 0) {
                isPrime = false;
            }
        }

        if (isPrime)
            System.out.println(number + " is Prime");
        else
            System.out.println(number + " is Not Prime");
    }

    public static void main(String[] args) {
        PrimeChecker p = new PrimeChecker();

        p.check(17);
        p.check(20);

        System.out.println("Total Checks: " + totalPrimeChecks);
    }
}
//Q24. Fibonacci series
class Fibonacci {
    static int seriesCount = 0;

    void display(int n) {
        seriesCount++;

        int first = 0;
        int second = 1;

        System.out.print("Fibonacci Series: ");

        for (int i = 1; i <= n; i++) {
            System.out.print(first + " ");

            int next = first + second;
            first = second;
            second = next;
        }

        System.out.println();
    }

    public static void main(String[] args) {
        Fibonacci f = new Fibonacci();

        f.display(7);

        System.out.println("Series Count: " + seriesCount);
    }
}
//Q25. Factorial
class Factorial {
    static int totalCalls = 0;

    void calculate(int number) {
        totalCalls++;

        if (number < 0) {
            System.out.println("Factorial not defined");
            return;
        }

        long factorial = 1;

        for (int i = 1; i <= number; i++) {
            factorial = factorial * i;
        }

        System.out.println("Factorial of " + number
                + " = " + factorial);
    }

    public static void main(String[] args) {
        Factorial f = new Factorial();

        f.calculate(5);

        System.out.println("Total Calls: " + totalCalls);
    }
}
//Q26. Matrix addition and subtraction
class Matrix {
    int[][] values = new int[2][2];

    static String matrixType = "2x2 Matrix";

    Matrix(int a, int b, int c, int d) {
        values[0][0] = a;
        values[0][1] = b;
        values[1][0] = c;
        values[1][1] = d;
    }

    void display(int[][] result) {
        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 2; j++) {
                System.out.print(result[i][j] + " ");
            }
            System.out.println();
        }
    }

    void calculate(Matrix m) {
        int[][] sum = new int[2][2];
        int[][] difference = new int[2][2];

        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 2; j++) {
                sum[i][j] = values[i][j] + m.values[i][j];

                difference[i][j] =
                        values[i][j] - m.values[i][j];
            }
        }

        System.out.println("Addition:");
        display(sum);

        System.out.println("Subtraction:");
        display(difference);
    }

    public static void main(String[] args) {
        Matrix m1 = new Matrix(1, 2, 3, 4);
        Matrix m2 = new Matrix(5, 6, 7, 8);

        System.out.println(matrixType);
        m1.calculate(m2);
    }
}
//Q27. StringReverse
class StringReverse {
    static int totalReversals = 0;

    void reverse(String text) {
        totalReversals++;

        String reversed = "";

        for (int i = text.length() - 1; i >= 0; i--) {
            reversed = reversed + text.charAt(i);
        }

        System.out.println("Original String: " + text);
        System.out.println("Reversed String: " + reversed);
    }

    public static void main(String[] args) {
        StringReverse s = new StringReverse();

        s.reverse("Java");

        System.out.println("Total Reversals: " + totalReversals);
    }
}
