//Q30. Library – Issue and Return books
class Library {
    int booksAvailable;

    static String libraryName = "Central Library";

    Library(int books) {
        booksAvailable = books;
    }

    void issueBooks(int quantity) {
        if (quantity <= 0) {
            System.out.println("Invalid Quantity");
        } else if (quantity > booksAvailable) {
            System.out.println("Not Enough Books Available");
        } else {
            int remaining = booksAvailable - quantity;
            booksAvailable = remaining;

            System.out.println(quantity + " Books Issued");
            System.out.println("Available Books: " + booksAvailable);
        }
    }

    void returnBooks(int quantity) {
        if (quantity <= 0) {
            System.out.println("Invalid Quantity");
        } else {
            int updated = booksAvailable + quantity;
            booksAvailable = updated;

            System.out.println(quantity + " Books Returned");
            System.out.println("Available Books: " + booksAvailable);
        }
    }

    public static void main(String[] args) {
        Library l = new Library(50);

        System.out.println("Library: " + libraryName);

        l.issueBooks(5);
        l.returnBooks(2);
    }
}
    
